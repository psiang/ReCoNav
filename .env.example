# Set these in your shell; the program does not read .env files automatically.
# Extract benchmark/ here; choose any location.
# The default is ./data in your working directory.
RECONAV_DATA_ROOT=/absolute/path/to/downloaded-data
RECONAV_OUTPUT_ROOT=./outputs
RECONAV_CACHE_ROOT=./.cache
# Optional external baselines and original HM3DSem scene files:
RECONAV_EXTERNAL_ROOT=./external
RECONAV_MODEL_ROOT=./external/models
RECONAV_HM3D_ROOT=./external/hm3d/val
# Model endpoints and model IDs are user-supplied deployment settings.
QWEN_BASE_URL=http://127.0.0.1:8008/v1
QWEN_SERVED_MODEL_NAME=qwen3.8-27b
OPENAI_API_KEY=
GEMINI_API_KEY=
# Lang2LTL-2 only: missing text-embedding-3-large vectors (cached vectors are free).
RECONAV_EMBEDDING_API_KEY=
# Optional vector bundle downloaded from the GitHub release:
RECONAV_LANG2LTL_EMBEDDINGS=./external/resources/lang2ltl2/embeddings.zip
# Optional Habitat navigation bundle for simulator-based methods:
RECONAV_HABITAT_NAVIGATION_ROOT=./external/resources/habitat-navigation
